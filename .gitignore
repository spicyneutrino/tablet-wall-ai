# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build / package artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local application data
*.db
*.sqlite
*.sqlite3
assets/
media/
*.schema.lock
*.pre-schema-*.bak

# Temporary files
tmp/
temp/

# Local audit and browser artifacts retained from prior runs
.audit/
.playwright-mcp/
docs/planning/tablet-wall-roadmap-2026-10-23/recovered/

# Stable single-worker ownership inode; never remove it while running
*.runtime.lock
