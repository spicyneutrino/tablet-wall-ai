# Reference for a laptop hotspot, not a production credential or certificate.
# Set WALL_HOTSPOT_IP to the address assigned to the laptop's hotspot interface.
# Set WALL_OPERATOR_PASSWORD_HASH to a Caddy `hash-password` result (never a
# plaintext password). Set WALL_OPERATOR_CREDENTIAL to the same random value
# the backend receives as TABLET_WALL_OPERATOR_CREDENTIAL; it is injected only
# after operator authentication. Both services must already be on
# loopback:8000.
{
	auto_https disable_redirects
}

https://{$WALL_HOTSPOT_IP}:8443 {
	bind {$WALL_HOTSPOT_IP}
	tls internal

	import tablet-routes.caddy
}

# Only the laptop itself may reach the operator origin in this hotspot example.
# For a later server/VPN deployment, replace the bind/address and re-test the
# entire ingress; do not expose this operator listener to the tablet LAN.
https://localhost:8444 {
	bind 127.0.0.1 ::1
	tls internal
	basic_auth {
		operator {$WALL_OPERATOR_PASSWORD_HASH}
	}
	reverse_proxy 127.0.0.1:8000 {
		# Overwrite any client-supplied value after basic_auth succeeds.
		# The backend trusts this header only in proxy mode, together with
		# the exact operator Origin.
		header_up X-Tablet-Wall-Operator {env.WALL_OPERATOR_CREDENTIAL}
		header_up -Authorization
		header_up -Cookie
	}
}
