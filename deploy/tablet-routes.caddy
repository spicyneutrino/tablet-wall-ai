	@client_redirect {
		method GET HEAD
		path /client
	}
	handle @client_redirect {
		redir * /client/ 308
	}

	# Exact public tablet surface. No unmatched URL or method is forwarded;
	# /assets (inventory), /uploads, /media, /diagnostics, rebinding, the operator socket, and all wall
	# writes are denied. Every upstream strips the internal operator credential,
	# so a forged header from a tablet never reaches the backend.
	@client {
		method GET
		path /client/ /client/index.html /client/client.js /client/client.css /client/view.js /client/ruler.js
	}
	handle @client {
		reverse_proxy 127.0.0.1:{$WALL_BACKEND_PORT:8000} {
			header_up -X-Tablet-Wall-Operator
		}
	}

	@register {
		method POST
		path /devices/register
	}
	handle @register {
		reverse_proxy 127.0.0.1:{$WALL_BACKEND_PORT:8000} {
			header_up -X-Tablet-Wall-Operator
		}
	}

	@device_socket {
		method GET
		path /ws/device
	}
	handle @device_socket {
		reverse_proxy 127.0.0.1:{$WALL_BACKEND_PORT:8000} {
			header_up -X-Tablet-Wall-Operator
		}
	}

	@asset_bytes {
		method GET HEAD
		path_regexp ^/assets/sha256:[0-9a-f]{64}$
	}
	handle @asset_bytes {
		reverse_proxy 127.0.0.1:{$WALL_BACKEND_PORT:8000} {
			header_up -X-Tablet-Wall-Operator
		}
	}

	handle {
		respond "Forbidden" 403
	}
